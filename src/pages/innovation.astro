---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/innovation.css';
---

<BaseLayout
  current="innovation"
  title="Innovation — neumACt R&I · CHUAC · INIBIC"
  description="Medical device, digital health, and AI/ML innovation projects from the Servicio de Neumología, CHUAC. Open to clinical and industry partnerships."
  path="/innovation"
>
<section class="hero" id="top">
    <div class="container">
      <div class="hero-inner">
        <div>
          <h1 class="display xl hero-title">
            <span lang="en">Technology<br>in service of<br><em>respiratory medicine.</em></span>
            <span lang="es">Tecnología<br>al servicio de la<br><em>medicina respiratoria.</em></span>
          </h1>
          <p class="hero-desc">
            <span lang="en">Innovation at the Servicio de Neumología is driven by clinical need — problems encountered daily in the treatment of patients with respiratory disease. Tools are developed with the clinicians who will use them, evaluated within the Fundación Galega de Investigación Biomédica (INIBIC) framework, and measured by their impact on diagnosis and patient outcomes.</span>
            <span lang="es">La innovación en el Servicio de Neumología parte de la necesidad clínica — problemas encontrados a diario en el tratamiento de pacientes con enfermedades respiratorias. Las herramientas se desarrollan con los clínicos que las usarán, se evalúan dentro del marco de la Fundación Galega de Investigación Biomédica (INIBIC) y se miden por su impacto en el diagnóstico y los resultados de los pacientes.</span>
          </p>
          <div class="hero-actions" style="display:flex;gap:1.75rem;align-items:center;">
            <a href="#projects" class="hero-text-link">
              <span lang="en">Active Projects</span><span lang="es">Proyectos Activos</span> →
            </a>
            <a href="#contact" class="hero-text-link">
              <span lang="en">Enquire</span><span lang="es">Contactar</span> →
            </a>
          </div>
        </div>
        <!-- Framework preview panel -->
        <div class="hero-framework reveal reveal-d2">
          <p class="label"><span lang="en">Development pathway</span><span lang="es">Proceso de desarrollo</span></p>
          <div class="fw-steps">
            <div class="fw-step"><div class="fw-num">01</div><span class="fw-step-label"><span lang="en">Clinical Insight &amp; Need Identification</span><span lang="es">Identificación de Necesidad Clínica</span></span></div>
            <div class="fw-step"><div class="fw-num">02</div><span class="fw-step-label"><span lang="en">Co-Development &amp; Prototyping</span><span lang="es">Co-Desarrollo y Prototipado</span></span></div>
            <div class="fw-step"><div class="fw-num">03</div><span class="fw-step-label"><span lang="en">Clinical Validation &amp; Evidence</span><span lang="es">Validación Clínica y Evidencia</span></span></div>
            <div class="fw-step"><div class="fw-num">04</div><span class="fw-step-label"><span lang="en">Integration &amp; Scale-Up</span><span lang="es">Integración y Escalado</span></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VISUAL PIPELINE — the design upgrade -->
  <section class="section pipeline-bg" id="pipeline">
    <div class="container">
      <div class="sec-head reveal">
        <p class="label"><span lang="en">Structured Approach</span><span lang="es">Enfoque Estructurado</span></p>
        <h2 class="display lg"><span lang="en">How we work</span><span lang="es">Cómo trabajamos</span></h2>
        <p><span lang="en">A proven four-phase methodology that transforms clinical challenges into market-ready solutions — with the hospital as the development and validation stage.</span><span lang="es">Una metodología de cuatro fases probada que transforma desafíos clínicos en soluciones listas para el mercado.</span></p>
      </div>

      <div class="pipeline-track">
        <div class="pipeline-stages">
          <div class="pipeline-stage reveal">
            <p class="stage-step"><span lang="en">Phase 01</span><span lang="es">Fase 01</span></p>
            <h3 class="stage-title"><span lang="en">Clinical Insight</span><span lang="es">Conocimiento Clínico</span></h3>
            <p class="stage-desc"><span lang="en">Identifying unmet needs through direct collaboration with respiratory specialists and structured patient engagement.</span><span lang="es">Identificar necesidades no cubiertas mediante colaboración directa con especialistas.</span></p>
            <ul class="stage-list"><li><span lang="en">Clinical need assessment</span><span lang="es">Evaluación de necesidades</span></li><li><span lang="en">Workflow analysis</span><span lang="es">Análisis de flujos</span></li><li><span lang="en">Patient journey mapping</span><span lang="es">Mapeo del paciente</span></li></ul>
          </div>
          <div class="pipeline-stage reveal reveal-d1">
            <p class="stage-step"><span lang="en">Phase 02</span><span lang="es">Fase 02</span></p>
            <h3 class="stage-title"><span lang="en">Co-Development</span><span lang="es">Co-Desarrollo</span></h3>
            <p class="stage-desc"><span lang="en">Co-creating solutions with your team, ensuring clinical relevance at every prototyping iteration with embedded specialist feedback.</span><span lang="es">Co-creando soluciones garantizando relevancia clínica en cada iteración de prototipado.</span></p>
            <ul class="stage-list"><li><span lang="en">Prototype development</span><span lang="es">Desarrollo de prototipos</span></li><li><span lang="en">Technical feasibility</span><span lang="es">Estudios de viabilidad</span></li><li><span lang="en">Iterative refinement</span><span lang="es">Refinamiento iterativo</span></li></ul>
          </div>
          <div class="pipeline-stage reveal reveal-d2">
            <p class="stage-step"><span lang="en">Phase 03</span><span lang="es">Fase 03</span></p>
            <h3 class="stage-title"><span lang="en">Clinical Validation</span><span lang="es">Validación Clínica</span></h3>
            <p class="stage-desc"><span lang="en">Structured real-world testing with GCP-compliant infrastructure and our pre-phenotyped patient cohort to build solid regulatory evidence.</span><span lang="es">Pruebas rigurosas con infraestructura GCP y cohorte de pacientes pre-fenotipados para generar evidencia regulatoria sólida.</span></p>
            <ul class="stage-list"><li><span lang="en">Pilot &amp; feasibility studies</span><span lang="es">Estudios piloto</span></li><li><span lang="en">Clinical trials (CE/FDA)</span><span lang="es">Ensayos clínicos (CE/FDA)</span></li><li><span lang="en">Real-world evidence</span><span lang="es">Evidencia del mundo real</span></li></ul>
          </div>
          <div class="pipeline-stage reveal reveal-d3">
            <p class="stage-step"><span lang="en">Phase 04</span><span lang="es">Fase 04</span></p>
            <h3 class="stage-title"><span lang="en">Integration &amp; Scale</span><span lang="es">Integración y Escalado</span></h3>
            <p class="stage-desc"><span lang="en">Supporting adoption into clinical workflows and building the evidence case for broader scale-up across the SERGAS network.</span><span lang="es">Apoyando la adopción en flujos clínicos y construyendo el caso para un escalado más amplio en la red SERGAS.</span></p>
            <ul class="stage-list"><li><span lang="en">Workflow integration</span><span lang="es">Integración de flujos</span></li><li><span lang="en">Adoption strategies</span><span lang="es">Estrategias de adopción</span></li><li><span lang="en">SERGAS network scale-up</span><span lang="es">Escalado red SERGAS</span></li></ul>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- STAT BREAK -->
  <div style="background:var(--off-white);padding:2rem 0;border-top:1px solid var(--rule-l);">
    <div style="padding:0 clamp(1.5rem,4vw,5rem);display:flex;align-items:center;gap:3rem;flex-wrap:wrap;">
      <div style="display:flex;align-items:baseline;gap:.75rem;">
        <span style="font-family:var(--ff-display);font-size:2.5rem;font-weight:300;color:var(--navy);line-height:1;letter-spacing:-.03em;">4</span>
        <span style="font-size:.875rem;color:var(--text-on-light-2);">
          <span lang="en">phases · Insight → Co-development → Validation → Scale</span>
          <span lang="es">fases · Identificación → Codesarrollo → Validación → Escalado</span>
        </span>
      </div>
      <div style="width:1px;height:32px;background:var(--rule-l);flex-shrink:0;" aria-hidden="true"></div>
      <div style="display:flex;align-items:baseline;gap:.75rem;">
        <span style="font-family:var(--ff-display);font-size:2.5rem;font-weight:300;color:var(--navy);line-height:1;letter-spacing:-.03em;">SERGAS</span>
        <span style="font-size:.875rem;color:var(--text-on-light-2);">
          <span lang="en">network scale-up pathway</span>
          <span lang="es">vía de escalado en red asistencial</span>
        </span>
      </div>
    </div>
  </div>

  <!-- ACTIVE PROJECTS — api.js target: id="projectsGrid" -->
  <section class="section projects-bg" id="projects">
    <div class="container">
      <div class="sec-head reveal">
        <p class="label"><span lang="en">Open Collaborations</span><span lang="es">Colaboraciones Abiertas</span></p>
        <h2 class="display lg"><span lang="en">Active projects</span><span lang="es">Proyectos activos</span></h2>
        <p style="max-width:600px;"><span lang="en">Ongoing initiatives where external partners can contribute technical expertise, co-invest, or provide scale-up capabilities. Current open projects include AIRWAYSCOPE (explainable AI / RAG platform for treatable traits) and CBI-EPOC (corticosteroid burden index platform). Contact us to explore entry points.</span><span lang="es">Iniciativas en curso donde socios externos pueden contribuir experiencia técnica, co-invertir o proporcionar capacidades de escalado. Proyectos abiertos actuales: AIRWAYSCOPE (plataforma IA explicable / RAG para rasgos tratables) y CBI-EPOC (índice de carga corticoidea). Contáctenos para explorar puntos de entrada.</span></p>
      </div>

      <!-- api.js replaces these static cards -->
      <div class="projects-grid" id="projectsGrid">
        <!-- Populated by api.js loadProjects() from /api/innovation-projects/website -->
      </div><!-- /#projectsGrid -->

      <div class="text-center" style="margin-top:2rem;">
        <a href="#contact" class="btn-cta-solid">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          <span lang="en">Enquire</span><span lang="es">Contactar</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="section cap-bg" id="capabilities">
    <div class="container">
      <div class="sec-head reveal">
        <p class="label"><span lang="en">What We Bring</span><span lang="es">Lo Que Aportamos</span></p>
        <h2 class="display lg"><span lang="en">Capabilities</span><span lang="es">Capacidades</span></h2>
        <p><span lang="en">The assets and expertise that make neumACt R&amp;I a structured clinical evaluation site.</span><span lang="es">Los activos y experiencia que hacen de neumACt R&amp;I un socio de innovación clínica de alto valor.</span></p>
      </div>
      <div class="cap-grid">
        <div class="cap-card reveal">
          <div class="cap-header"><p class="cap-title"><span lang="en">Clinical Data &amp; Biobank</span><span lang="es">Datos Clínicos y Biobanco</span></p><span class="cap-num">01</span></div><div class="cap-pills"><span class="cap-pill">Annotated</span><span class="cap-pill">Longitudinal</span><span class="cap-pill">GDPR-compliant</span></div>
          <p class="cap-desc"><span lang="en">Curated, structured clinical datasets with expert annotations across all disease domains — ready for AI training, algorithm validation, and retrospective analysis.</span><span lang="es">Conjuntos de datos clínicos curados con anotaciones expertas en todos los dominios de enfermedad.</span></p>
          <ul class="cap-list"><li><span lang="en">3,200+ annotated CT scans (ILD, lung cancer)</span><span lang="es">3.200+ TCs anotadas (EPI, cáncer de pulmón)</span></li><li><span lang="en">Longitudinal spirometry + biomarker cohorts</span><span lang="es">Cohortes longitudinales de espirometría y biomarcadores</span></li><li><span lang="en">Linked EHR data for outcomes research</span><span lang="es">Datos HCE vinculados para investigación de resultados</span></li></ul>
        </div>
        <div class="cap-card reveal reveal-d1">
          <div class="cap-header"><p class="cap-title"><span lang="en">Specialist Clinical Team</span><span lang="es">Equipo Clínico Especialista</span></p><span class="cap-num">02</span></div><div class="cap-pills"><span class="cap-pill">6 Research Lines</span><span class="cap-pill">GCP certified</span></div>
          <p class="cap-desc"><span lang="en">Direct access to respiratory and thoracic surgery specialists across all six research lines — providing clinical oversight, protocol design, and expert annotation.</span><span lang="es">Acceso directo a especialistas respiratorios y de cirugía torácica en las seis líneas de investigación.</span></p>
          <ul class="cap-list"><li><span lang="en">Dedicated innovation co-PI per project</span><span lang="es">Co-IP de innovación dedicado por proyecto</span></li><li><span lang="en">Expert-labelled datasets &amp; validation review</span><span lang="es">Conjuntos de datos etiquetados por expertos</span></li><li><span lang="en">Regulatory pathway advisory</span><span lang="es">Asesoría en vías regulatorias</span></li></ul>
        </div>
        <div class="cap-card reveal reveal-d1">
          <div class="cap-header"><p class="cap-title"><span lang="en">Patient Recruitment</span><span lang="es">Reclutamiento de Pacientes</span></p><span class="cap-num">03</span></div><div class="cap-pills"><span class="cap-pill">High-volume</span><span class="cap-pill">Pre-phenotyped</span></div>
          <p class="cap-desc"><span lang="en">A high-volume tertiary centre with pre-phenotyped patient registries across all target conditions — enabling rapid recruitment with streamlined ethics processes.</span><span lang="es">Centro terciario de alto volumen con registros de pacientes pre-fenotipados, permitiendo reclutamiento rápido.</span></p>
          <ul class="cap-list"><li><span lang="en">Pre-screened registries per disease domain</span><span lang="es">Registros pre-cribados por dominio de enfermedad</span></li><li><span lang="en">Streamlined ethics &amp; consent processes</span><span lang="es">Procesos simplificados de ética y consentimiento</span></li><li><span lang="en">Site initiation avg. under 6 weeks</span><span lang="es">Inicio de sitio medio inferior a 6 semanas</span></li></ul>
        </div>
        <div class="cap-card reveal reveal-d2">
          <div class="cap-header"><p class="cap-title"><span lang="en">Regulatory &amp; IP Support</span><span lang="es">Soporte Regulatorio y PI</span></p><span class="cap-num">04</span></div><div class="cap-pills"><span class="cap-pill">INIBIC</span><span class="cap-pill">MDR experience</span></div>
          <p class="cap-desc"><span lang="en">INIBIC-backed research infrastructure with experienced navigation of CE MDR, FDA breakthrough device pathways, and AEMPS submission processes for medical devices and SaMD.</span><span lang="es">Infraestructura respaldada por INIBIC con experiencia en CE MDR, FDA y procesos ante AEMPS.</span></p>
          <ul class="cap-list"><li><span lang="en">CE MDR &amp; IVDR technical file support</span><span lang="es">Soporte expedientes técnicos CE MDR e IVDR</span></li><li><span lang="en">IP framework for joint inventions</span><span lang="es">Marco de PI para invenciones conjuntas</span></li><li><span lang="en">SERGAS institutional endorsement pathway</span><span lang="es">Vía de aval institucional SERGAS</span></li></ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ACTIVE FOCUS AREAS -->
  <section class="section focus-bg" id="focus-areas">
    <div class="container">
      <div class="focus-intro">
        <div>
          <p class="label" style="color:var(--teal-2);opacity:.9;margin-bottom:.625rem;"><span lang="en">Active Research Focus</span><span lang="es">Foco de Investigación Activo</span></p>
          <h2 class="display lg" style="color:#F5F5F0;">
            <span lang="en">Technologies We Are<br>Currently Exploring</span>
            <span lang="es">Tecnologías que Estamos<br>Explorando Actualmente</span>
          </h2>
        </div>
        <span class="focus-live">
          <span lang="en">Active programmes · Updated Q1 2026</span>
          <span lang="es">Programas activos · Actualizado Q1 2026</span>
        </span>
      </div>

      <div class="focus-grid reveal">

        <div class="focus-card">
          <span class="focus-tag"><span lang="en">AI · Machine Learning</span><span lang="es">IA · Aprendizaje Automático</span></span>
          <div class="focus-title"><span lang="en">AI-Assisted Diagnostics in Respiratory Medicine</span><span lang="es">Diagnóstico Asistido por IA en Medicina Respiratoria</span></div>
          <p class="focus-desc"><span lang="en">Convolutional and transformer models for early disease classification, progression scoring, and treatment response prediction across ILD, COPD, and lung cancer cohorts.</span><span lang="es">Modelos convolucionales y transformers para clasificación temprana, puntuación de progresión y predicción de respuesta al tratamiento en cohortes de EPI, EPOC y cáncer de pulmón.</span></p>
          <div class="focus-cohorts">
            <span class="focus-cohort"><span lang="en">ILD / IPF subtype classification</span><span lang="es">Clasificación de subtipos EPI / FPI</span></span>
            <span class="focus-cohort"><span lang="en">COPD exacerbation prediction</span><span lang="es">Predicción de exacerbaciones EPOC</span></span>
            <span class="focus-cohort"><span lang="en">Lung cancer staging support</span><span lang="es">Apoyo a la estadificación del cáncer de pulmón</span></span>
          </div>
          <div class="focus-status"><span lang="en">Currently executing · Active validation</span><span lang="es">En ejecución · Validación activa</span></div>
        </div>

        <div class="focus-card">
          <span class="focus-tag"><span lang="en">VR · AR · Simulation</span><span lang="es">RV · RA · Simulación</span></span>
          <div class="focus-title"><span lang="en">Extended Reality in Pulmonology &amp; Thoracic Surgery</span><span lang="es">Realidad Extendida en Neumología y Cirugía Torácica</span></div>
          <p class="focus-desc"><span lang="en">Immersive simulation for procedural training, AR-guided intraoperative navigation for VATS/RATS, and VR-based patient pre-operative education tools validated against clinical outcomes.</span><span lang="es">Simulación inmersiva para formación procedimental, navegación intraoperatoria guiada por AR en VATS/RATS y herramientas de educación preoperatoria basadas en RV.</span></p>
          <div class="focus-cohorts">
            <span class="focus-cohort"><span lang="en">VATS/RATS sublobar resection · AR overlay</span><span lang="es">Resección sublobar VATS/RATS · superposición AR</span></span>
            <span class="focus-cohort"><span lang="en">Bronchoscopy simulation training</span><span lang="es">Simulación de entrenamiento en broncoscopia</span></span>
            <span class="focus-cohort"><span lang="en">Patient pre-procedure VR education</span><span lang="es">Educación preoperatoria VR del paciente</span></span>
          </div>
          <div class="focus-status"><span lang="en">Co-development phase · Partners welcome</span><span lang="es">Fase de codesarrollo · Socios bienvenidos</span></div>
        </div>

        <div class="focus-card">
          <span class="focus-tag"><span lang="en">Digital Health · SaMD</span><span lang="es">Salud Digital · SaMD</span></span>
          <div class="focus-title"><span lang="en">Remote Monitoring &amp; Predictive Clinical Platforms</span><span lang="es">Monitorización Remota y Plataformas Clínicas Predictivas</span></div>
          <p class="focus-desc"><span lang="en">Wearable and sensor-based remote monitoring platforms generating continuous respiratory data streams, feeding decision-support algorithms for outpatient chronic disease management.</span><span lang="es">Plataformas de monitorización remota basadas en sensores que generan flujos continuos de datos respiratorios para algoritmos de soporte a la decisión en el manejo ambulatorio de enfermedades crónicas.</span></p>
          <div class="focus-cohorts">
            <span class="focus-cohort"><span lang="en">COPD continuous SpO₂ + RR monitoring</span><span lang="es">Monitorización continua SpO₂ + FR en EPOC</span></span>
            <span class="focus-cohort"><span lang="en">Severe asthma biologic response tracking</span><span lang="es">Seguimiento de respuesta a biológicos en asma grave</span></span>
            <span class="focus-cohort"><span lang="en">NIV compliance + outcomes monitoring</span><span lang="es">Cumplimiento VNI y monitorización de resultados</span></span>
          </div>
          <div class="focus-status"><span lang="en">Pilot phase · 30-patient study active</span><span lang="es">Fase piloto · Estudio de 30 pacientes activo</span></div>
        </div>

        <div class="focus-card">
          <span class="focus-tag"><span lang="en">Biomarkers · Precision Medicine</span><span lang="es">Biomarcadores · Medicina de Precisión</span></span>
          <div class="focus-title"><span lang="en">Multi-Omic Profiling for Personalised Respiratory Treatment</span><span lang="es">Perfil Multi-Ómico para Tratamiento Respiratorio Personalizado</span></div>
          <p class="focus-desc"><span lang="en">Integrating genomic, proteomic, and clinical phenotype data to build precision treatment algorithms — particularly for biologic selection in severe asthma and immunosuppression optimisation in lung transplant.</span><span lang="es">Integración de datos genómicos, proteómicos y fenotipo clínico para construir algoritmos de tratamiento de precisión en asma grave y trasplante pulmonar.</span></p>
          <div class="focus-cohorts">
            <span class="focus-cohort"><span lang="en">Biologic selection algorithm · Severe asthma</span><span lang="es">Algoritmo de selección de biológicos · Asma grave</span></span>
            <span class="focus-cohort"><span lang="en">Transplant rejection early biomarkers</span><span lang="es">Biomarcadores precoces de rechazo en trasplante</span></span>
            <span class="focus-cohort"><span lang="en">COPD precision phenotyping</span><span lang="es">Fenotipado de precisión en EPOC</span></span>
          </div>
          <div class="focus-status"><span lang="en">Protocol defined · Data collection underway</span><span lang="es">Protocolo definido · Recogida de datos en curso</span></div>
        </div>

      </div>
    </div>
  </section>

  <!-- PARTNER ORGANISATIONS -->
  <section class="partner-strip-bg">
    <div class="container">
      <div class="partner-strip-inner">
        <span class="partner-strip-label"><span lang="en">Collaborating with</span><span lang="es">Colaborando con</span></span>
        <div class="partner-logos">
          <span class="partner-logo-item">INIBIC</span>
          <span class="partner-logo-item">SERGAS</span>
          <span class="partner-logo-item">HUAC</span>
          <span class="partner-logo-item">CHUAC</span>
          <span class="partner-logo-item">AEMPS</span>
          <span class="partner-logo-item">SEPAR</span>
          <span class="partner-logo-item">SEMI</span>
          <span class="partner-logo-item">ISCIII</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PARTNERSHIP MODELS -->
  <section class="section partner-bg" id="partnership">
    <div class="container partner-inner">
      <div class="sec-head reveal">
        <p class="label"><span lang="en">How We Work Together</span><span lang="es">Cómo Trabajamos Juntos</span></p>
        <h2 class="display lg"><span lang="en">Engagement</span><span lang="es">Modelos de colaboración</span></h2>
        <p><span lang="en">We adapt to your project stage and strategic goals. All models are built around shared value creation and clear IP arrangements agreed upfront.</span><span lang="es">Nos adaptamos a la etapa de su proyecto con acuerdos de PI claros desde el inicio.</span></p>
      </div>
      <div class="partner-models">
        <div class="pm-card reveal"><div class="pm-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div>
          <div class="pm-body"><h3 class="pm-title"><span lang="en">Co-Development</span><span lang="es">Co-Desarrollo</span></h3>
          <p class="pm-desc"><span lang="en">Joint development combining neumACt R&amp;I's clinical insight and patient access with your technical expertise. Suitable for early-stage projects requiring clinical co-design.</span><span lang="es">Desarrollo conjunto combinando el conocimiento clínico de neumACt R&amp;I con su experiencia técnica. Para proyectos en etapa temprana.</span></p>
          <ul class="pm-benefits"><li><span lang="en">Shared intellectual property</span><span lang="es">Propiedad intelectual compartida</span></li><li><span lang="en">Dedicated joint project team</span><span lang="es">Equipo de proyecto conjunto</span></li><li><span lang="en">Shared risk and reward</span><span lang="es">Riesgo y recompensa compartidos</span></li><li><span lang="en">Faster time to clinical evidence</span><span lang="es">Tiempo más rápido a evidencia clínica</span></li></ul></div>
        </div>
